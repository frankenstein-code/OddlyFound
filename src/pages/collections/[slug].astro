---
import { getCollection, getEntry } from "astro:content";
import ProductCard from "../../components/ProductCard.astro";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const collections = await getCollection("collections", ({ data }) => !data.draft);
  return collections.map((collection) => ({ params: { slug: collection.id }, props: { collection } }));
}

const { collection } = Astro.props;
const relatedEntries = await Promise.all(
  collection.data.products.map((reference) => getEntry(reference)),
);
const relatedProducts = relatedEntries.filter(
  (product) => product && !product.data.draft,
);
const categoryEntries = await getCollection("categories", ({ data }) => !data.draft);
const categoryNames = new Map(categoryEntries.map((category) => [category.id, category.data.name]));
const publicCategoryIds = new Set(categoryEntries.map((category) => category.id));
const visibleProducts = relatedProducts.filter((product) =>
  publicCategoryIds.has(product.data.category.id),
);
---

<SiteLayout title={collection.data.title} description={collection.data.description} socialImage={collection.data.image}>
  <nav aria-label="Breadcrumb" class="mb-6 text-sm">
    <a href="/collections/">Collections</a> <span aria-hidden="true">/</span> {collection.data.title}
  </nav>
  <header class="mb-8 max-w-3xl">
    <p class="category-eyebrow font-bold uppercase tracking-wide">Curated collection</p>
    <h1 class="mt-2 text-5xl font-black tracking-tight">{collection.data.title}</h1>
    <p class="mt-3 text-lg text-muted">{collection.data.description}</p>
  </header>
  {collection.data.image && (
    <img
      class="mb-8 aspect-[16/9] max-h-[32rem] w-full rounded-[1.75rem] bg-lilac object-cover"
      src={collection.data.image}
      alt={collection.data.imageAlt ?? ""}
      decoding="async"
    />
  )}
  {visibleProducts.length ? (
    <ul class="grid list-none gap-5 p-0 sm:grid-cols-2 lg:grid-cols-3">
      {visibleProducts.map((product) => (
        <ProductCard product={product} categoryName={categoryNames.get(product.data.category.id) ?? "Find"} />
      ))}
    </ul>
  ) : (
    <p class="empty-state">
      Products for this collection will appear here when published.
    </p>
  )}
</SiteLayout>
