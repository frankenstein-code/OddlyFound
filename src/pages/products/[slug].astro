---
import { getCollection, getEntry } from "astro:content";
import { requireAffiliateDisclosure } from "../../lib/affiliate";
import site from "../../data/site.json";
import SiteLayout from "../../layouts/SiteLayout.astro";

export async function getStaticPaths() {
  const [products, categories] = await Promise.all([
    getCollection("products", ({ data }) => !data.draft),
    getCollection("categories", ({ data }) => !data.draft),
  ]);
  const categoryIds = new Set(categories.map((category) => category.id));
  const publicProducts = products.filter((product) => categoryIds.has(product.data.category.id));
  requireAffiliateDisclosure(publicProducts, site.affiliateDisclosure);
  return publicProducts.map((product) => ({ params: { slug: product.id }, props: { product } }));
}

const { product } = Astro.props;
const category = await getEntry(product.data.category);
const formattedPrice = product.data.price === undefined
  ? undefined
  : new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: product.data.currency ?? "INR",
    }).format(product.data.price);
const productSchema = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: product.data.name,
  description: product.data.description,
  ...(product.data.image ? { image: new URL(product.data.image, site.url).toString() } : {}),
};
---

<SiteLayout
  title={product.data.name}
  description={product.data.description}
  socialImage={product.data.image}
  jsonLd={productSchema}
>
  <nav aria-label="Breadcrumb" class="mb-6 text-sm">
    <a href="/products/">Finds</a> <span aria-hidden="true">/</span> {product.data.name}
  </nav>
  <article class="mx-auto max-w-4xl">
    <header class="mb-8">
      <p class="category-eyebrow font-bold uppercase tracking-wide">{category?.data.name}</p>
      <h1 class="mt-2 text-5xl font-black tracking-tight">{product.data.name}</h1>
      <p class="mt-4 max-w-3xl text-xl text-muted">{product.data.description}</p>
    </header>
    {product.data.image && (
      <img
        class="mb-8 aspect-[16/9] max-h-[36rem] w-full rounded-[1.75rem] bg-lilac object-contain"
        src={product.data.image}
        alt={product.data.imageAlt ?? ""}
        decoding="async"
      />
    )}
    {product.data.price !== undefined && (
      <p class="mb-6 text-lg">
        <strong>Editorially noted price:</strong> {formattedPrice}
        {product.data.priceAsOf
          ? ` (noted ${product.data.priceAsOf.toLocaleDateString("en-IN", { dateStyle: "long" })}; not live-verified)`
          : " (date not supplied; not live-verified)"}
      </p>
    )}
    {product.data.affiliateUrl && (
      <aside class="notice-surface mb-8 rounded-2xl border p-6">
        <p>{site.affiliateDisclosure}</p>
        <a
          class="affiliate-cta mt-4 inline-flex rounded-full bg-magenta-deep px-5 py-3 font-bold text-white no-underline hover:bg-ink"
          href={product.data.affiliateUrl}
          rel="sponsored nofollow"
        >Visit {product.data.merchant ?? "the merchant"}</a>
      </aside>
    )}
    {product.data.pros.length > 0 && (
      <section class="mb-6">
        <h2 class="text-2xl font-bold">What stands out</h2>
        <ul class="mt-3 list-disc space-y-2 pl-6">
          {product.data.pros.map((pro) => <li>{pro}</li>)}
        </ul>
      </section>
    )}
    {product.data.cons.length > 0 && (
      <section class="mb-6">
        <h2 class="text-2xl font-bold">Things to consider</h2>
        <ul class="mt-3 list-disc space-y-2 pl-6">
          {product.data.cons.map((con) => <li>{con}</li>)}
        </ul>
      </section>
    )}
    {product.data.editorialNotes && <p class="prose-content">{product.data.editorialNotes}</p>}
  </article>
</SiteLayout>
