---
import site from "../data/site.json";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  socialImage?: string;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = site.tagline,
  canonical = new URL(Astro.url.pathname, site.url).toString(),
  socialImage,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const socialImageUrl = socialImage ? new URL(socialImage, site.url).toString() : undefined;
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replaceAll("<", "\\u003c") : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={socialImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header bg-card">
      <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-5 py-5">
        <a class="inline-flex items-center rounded focus-visible:outline-offset-4" href="/" aria-label={`${site.name} home`}>
          <img class="brand-logo" src="/images/oddlyfound-logo.png" alt={site.name} width="640" height="408" />
        </a>
        <nav class="site-nav" aria-label="Main navigation">
          <ul class="flex flex-wrap gap-x-5 gap-y-2 text-sm font-semibold">
            <li><a href="/products/">Finds</a></li>
            <li><a href="/categories/">Categories</a></li>
            <li><a href="/collections/">Collections</a></li>
            <li><a href="/articles/">Stories</a></li>
          </ul>
        </nav>
      </div>
    </header>
    <main id="main-content" class="mx-auto w-full max-w-6xl px-5 py-10">
      <slot />
    </main>
    <footer class="mt-12 border-t border-line bg-card">
      <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-4 px-5 py-8 text-sm text-muted">
        <p>{site.tagline}</p>
        <a href="/admin/">Editor access</a>
      </div>
    </footer>
  </body>
</html>
